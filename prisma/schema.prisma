// Camada — modelo de datos
// Importes en centavos (Int). Fechas en UTC; se muestran en America/Argentina/Buenos_Aires.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Usuarios y acceso ─────────────────────────

enum Role {
  TEXTIL_ADMIN // administra todo
  CLUB_ADMIN // gestiona su club
  PRODUCTION // ve lotes y cantidades, sin datos personales
  DELIVERY // consulta pedidos listos y registra retiros de su club
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  clubId       String?
  club         Club?     @relation(fields: [clubId], references: [id])
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  passwordResets PasswordReset[]

  @@index([clubId])
}

/// Restablecimiento de contraseña: token de un solo uso (solo se guarda su hash).
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String?

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?

  @@index([userId])
}

// ───────────────────────── Club ─────────────────────────

model Sport {
  id         String      @id @default(cuid())
  name       String      @unique
  clubs      ClubSport[]
  categories Category[]
  products   Product[]
  campaigns  Campaign[]   @relation("CampaignSports")
}

model Club {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  shortName      String?
  description    String?
  logoUrl        String?
  coverUrl       String?
  colorPrimary   String    @default("#0F4D3A")
  colorSecondary String    @default("#D9A520")
  city           String?
  province       String?
  venue          String? // sede
  pickupAddress  String?
  pickupHours    String? // horarios de retiro
  officeHours    String? // horarios de atención
  conditions     String? // condiciones particulares del club
  whatsapp       String?
  email          String?
  instagram      String?
  facebook       String?
  website        String?
  active         Boolean   @default(true)
  /// Club de demostración: la tienda muestra un aviso y solo admite pagos simulados.
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sports          ClubSport[]
  categories      Category[]
  photos          ClubPhoto[]
  users           User[]
  garments        Garment[]
  products        Product[]
  campaigns       Campaign[]
  paymentAccounts PaymentAccount[]
  buyers          Buyer[]
  orders          Order[]
  agreements      ClubAgreement[]
  sampleSets      SizeSampleSet[]
  purchases       ClubPurchase[]
  shipments       ClubShipment[]
}

model ClubSport {
  clubId  String
  sportId String
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sport   Sport  @relation(fields: [sportId], references: [id])

  @@id([clubId, sportId])
}

model Category {
  id      String  @id @default(cuid())
  clubId  String
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sportId String?
  sport   Sport?  @relation(fields: [sportId], references: [id])
  name    String
  sort    Int     @default(0)
  active  Boolean @default(true)
  campaigns Campaign[] @relation("CampaignCategories")
  ruleProducts CampaignProduct[]

  @@unique([clubId, sportId, name])
  @@index([clubId])
}

model ClubPhoto {
  id      String @id @default(cuid())
  clubId  String
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  url     String
  caption String?
  sort    Int    @default(0)
}

// ───────────────────────── Cobros ─────────────────────────

enum AccountOwner {
  TEXTIL
  CLUB
}

model PaymentAccount {
  id            String       @id @default(cuid())
  owner         AccountOwner
  clubId        String? // requerido si owner = CLUB
  club          Club?        @relation(fields: [clubId], references: [id])
  label         String
  // Transferencia
  bankHolder    String?
  bankName      String?
  bankCbu       String?
  bankAlias     String?
  bankCuit      String?
  // Mercado Pago (cifrado AES-256-GCM; nunca se envía al navegador)
  mpAccessTokenEnc   String?
  mpWebhookSecretEnc String?
  mpPublicLabel      String? // últimos dígitos para mostrar "configurado"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  campaigns     Campaign[]
}

// ───────────────────────── Catálogo ─────────────────────────

enum SizeGroup {
  KIDS
  NUMERIC
  ALPHA
  OTHER
}

/// Prenda fabricable. Es lo que consolida la orden de producción.
model Garment {
  id          String        @id @default(cuid())
  clubId      String
  club        Club          @relation(fields: [clubId], references: [id])
  code        String
  name        String
  variant     String? // titular, suplente, entrenamiento...
  material    String?
  care        String?
  measureA    String        @default("Ancho de pecho")
  measureB    String        @default("Largo")
  measureUnit String        @default("cm")
  measureNote String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  sizes       GarmentSize[]
  components  ProductComponent[]
  sampleSets  SizeSampleSet[]

  @@unique([clubId, code])
}

model GarmentSize {
  id        String    @id @default(cuid())
  garmentId String
  garment   Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  label     String
  group     SizeGroup
  sort      Int
  measureA  Decimal?  @db.Decimal(6, 1)
  measureB  Decimal?  @db.Decimal(6, 1)
  enabled   Boolean   @default(true)

  @@unique([garmentId, label])
}

enum CatalogStatus {
  PREPARATION // en preparación
  CATALOG // disponible en catálogo, sin venta
  PRESALE // en preventa activa
  PRESALE_CLOSED // con preventa cerrada
  ARCHIVED
}

/// Familia comercial (define reglas de activación). No se deduce del nombre.
enum ProductFamily {
  GAME_KIT // prenda de juego
  OUTFIT // outfit y prendas generales
  ACCESSORY
  OTHER
}

/// Técnica de fabricación, independiente de la familia.
enum FabricTechnique {
  PENDING
  SUBLIMATED
  NON_SUBLIMATED
  EMBROIDERED
  PRINTED
  OTHER
}

enum OptionGroupType {
  CHOICE // valores a elegir
  TEXT // texto libre (nombre)
  NUMBER
}

/// Rol de la opción para producción y política de cambios.
enum OptionRole {
  NAME
  NUMBER
  LEGEND // leyenda de disciplina
  OTHER
}

enum ProductKind {
  SIMPLE
  SET // conjunto
  COMBO
}

/// Lo que se vende. Un producto simple tiene un componente.
model Product {
  id                String             @id @default(cuid())
  clubId            String
  club              Club               @relation(fields: [clubId], references: [id])
  code              String
  name              String
  description       String?
  kind              ProductKind        @default(SIMPLE)
  sportId           String?
  sport             Sport?             @relation(fields: [sportId], references: [id])
  audience          String? // categoría o público
  basePrice         Int // centavos
  manufacturingTerms String?
  // Personalización por unidad
  persNameEnabled   Boolean            @default(false)
  persNamePrice     Int                @default(0)
  persNameMaxLen    Int                @default(12)
  persNumberEnabled Boolean            @default(false)
  persNumberPrice   Int                @default(0)
  persNumberMin     Int                @default(0)
  persNumberMax     Int                @default(99)
  catalogStatus     CatalogStatus      @default(PREPARATION)
  family            ProductFamily      @default(OTHER)
  technique         FabricTechnique    @default(PENDING)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  components        ProductComponent[]
  images            ProductImage[]
  campaigns         CampaignProduct[]
  optionGroups      ProductOptionGroup[]
  sampleLinks       ProductSampleLink[]
  purchases         ClubPurchase[]

  @@unique([clubId, code])
}

/// Grupo de opciones del configurador (personalización, leyenda, etc.).
model ProductOptionGroup {
  id              String            @id @default(cuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  type            OptionGroupType
  role            OptionRole        @default(OTHER)
  required        Boolean           @default(false)
  sort            Int               @default(0)
  help            String?
  // Dependencia: el grupo se muestra (y aplica "required") solo si otro grupo CHOICE tiene alguno de estos valores
  dependsOnGroupId String?
  dependsOnGroup  ProductOptionGroup?  @relation("OptionDependency", fields: [dependsOnGroupId], references: [id], onDelete: SetNull)
  dependents      ProductOptionGroup[] @relation("OptionDependency")
  dependsOnValueIds String[]        @default([])
  // TEXT / NUMBER
  maxLength       Int?
  numberMin       Int?
  numberMax       Int?
  // Precio de TEXT / NUMBER cuando se completa (centavos), separado en textil y club
  priceTextil     Int               @default(0)
  priceClub       Int               @default(0)
  splitConfirmed  Boolean           @default(false) // reparto textil/club definido comercialmente
  /// Si es true, la prenda con esta opción completada no admite cambio de talle voluntario
  blocksSizeChange Boolean          @default(false)
  values          ProductOptionValue[]
}

model ProductOptionValue {
  id          String             @id @default(cuid())
  groupId     String
  group       ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label       String
  sort        Int                @default(0)
  priceTextil Int                @default(0)
  priceClub   Int                @default(0)
  active      Boolean            @default(true)
}

model ProductComponent {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  garmentId   String
  garment     Garment @relation(fields: [garmentId], references: [id])
  label       String // "Camiseta", "Short"
  sort        Int     @default(0)
  printTarget Boolean @default(false) // recibe nombre y número

  @@unique([productId, label])
}

enum ImageView {
  FRONT
  BACK
  DETAIL
  OTHER
}

enum ImageTag {
  REAL // foto real del producto final
  DESIGN // render o diseño
  REFERENCE // foto de referencia (no es el producto final)
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  view      ImageView @default(FRONT)
  tag       ImageTag  @default(DESIGN)
  alt       String?
  sort      Int       @default(0)
}

// ───────────────────────── Campañas ─────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVATION_REQUESTED // el club solicitó activar
  ACTIVATION_APPROVED // la textil verificó condiciones y aprobó
  PUBLISHED
  CLOSED
  IN_PRODUCTION
  READY_FOR_PICKUP
  FINISHED
  CANCELLED
}

/// LEGACY_DEPOSIT: seña configurable (campañas anteriores). TEXTIL_ADVANCE: anticipo = precio textil, saldo al club.
enum PricingModel {
  LEGACY_DEPOSIT
  TEXTIL_ADVANCE
}

enum CampaignAudience {
  ALL // todo el club
  SPORTS // una o varias disciplinas
  CATEGORIES // una o varias categorías
}

enum ProductionRuleType {
  NONE
  FULL_CATEGORY // prenda de juego para una categoría completa
  INITIAL_PURCHASE // compra inicial del club (outfit)
}

enum PaymentMode {
  FULL // pago total obligatorio
  DEPOSIT // seña obligatoria (puede pagar total)
}

enum DepositType {
  PERCENT
  FIXED // importe fijo por pedido
}

enum MinDecision {
  EXTEND
  CANCEL
  CONTINUE
}

enum LotCondition {
  DEPOSIT_APPROVED
  FULLY_PAID
}

model Campaign {
  id                  String          @id @default(cuid())
  clubId              String
  club                Club            @relation(fields: [clubId], references: [id])
  slug                String
  title               String
  description         String?
  season              String?
  status              CampaignStatus  @default(DRAFT)
  pricingModel        PricingModel    @default(TEXTIL_ADVANCE)
  audience            CampaignAudience @default(ALL)
  audienceSports      Sport[]         @relation("CampaignSports")
  audienceCategories  Category[]      @relation("CampaignCategories")
  activationRequestedAt DateTime?
  activationRequestedById String?
  activationApprovedAt DateTime?
  activationApprovedById String?
  activationNote      String?
  opensAt             DateTime
  closesAt            DateTime
  deliveryDaysMin     Int             @default(30)
  deliveryDaysMax     Int             @default(40)
  showCatalogWhenClosed Boolean       @default(true)
  // Cobro
  paymentAccountId    String
  paymentAccount      PaymentAccount  @relation(fields: [paymentAccountId], references: [id])
  paymentMode         PaymentMode     @default(DEPOSIT)
  depositType         DepositType     @default(PERCENT)
  depositValue        Int             @default(50) // % o centavos
  balanceDueText      String? // "Antes del retiro, al recibir el aviso"
  allowMercadoPago    Boolean         @default(true)
  allowTransfer       Boolean         @default(true)
  mpReservationMinutes Int            @default(30)
  transferHoldHours   Int             @default(72)
  lotCondition        LotCondition    @default(DEPOSIT_APPROVED)
  // Producción
  minUnits            Int?
  maxUnits            Int? // cupo total opcional
  minDecision         MinDecision?
  minDecisionNote     String?
  minDecisionAt       DateTime?
  minDecisionById     String?
  // Entrega
  pickupEnabled       Boolean         @default(true)
  pickupInstructions  String?
  shippingEnabled     Boolean         @default(false)
  shippingPrice       Int             @default(0)
  shippingNotes       String?
  // Formulario
  memberNumberMode    String          @default("OPTIONAL") // HIDDEN | OPTIONAL | REQUIRED
  // Políticas
  policyChanges       String?
  policyCancellation  String?
  policyRefunds       String?
  minPolicyText       String? // qué pasa si no se alcanza el mínimo
  faq                 Json?
  productionNotice    String? // avance publicado para compradores
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  products            CampaignProduct[]
  orders              Order[]
  lots                ProductionLot[]
  shipments           ClubShipment[]
  purchases           ClubPurchase[]
  benefitRule         BenefitRule?
  settlements         BenefitSettlement[]

  @@unique([clubId, slug])
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  price      Int // precio al socio (centavos)
  listPrice  Int? // precio de lista, para mostrar el descuento real
  /// Precio textil (anticipo). Null en campañas con modelo de seña heredado.
  textilPrice Int?
  /// Recargo del club sobre el precio textil, en centésimas de % (3000 = 30 %), si el precio se calculó así
  markupBp   Int?
  maxUnits   Int?
  sort       Int      @default(0)
  active     Boolean  @default(true)
  // Regla de producción del producto en esta campaña
  ruleType   ProductionRuleType @default(NONE)
  ruleCategoryId String?
  ruleCategory Category? @relation(fields: [ruleCategoryId], references: [id])
  expectedQty Int? // categoría completa: cantidad esperada
  initialPurchaseMin Int? // outfit: compra inicial mínima (editable)
  initialPurchaseEstimated Boolean @default(true) // el mínimo es estimado, no confirmado
  initialPurchaseWaived Boolean @default(false) // excepción a la compra inicial
  ruleApprovedAt DateTime? // aprobación de la textil para abrir
  ruleApprovedById String?
  productionApprovedAt DateTime? // aprobación para producir (categoría completa con menos de lo esperado)
  ruleNote   String?
  clubPurchaseId String?
  clubPurchase ClubPurchase? @relation(fields: [clubPurchaseId], references: [id])

  @@unique([campaignId, productId])
}

// ───────────────────────── Beneficio del club ─────────────────────────

enum BenefitType {
  FIXED_PER_UNIT
  PERCENT_OF_GARMENTS // % sobre precio de prendas, sin personalización ni envío
}

model BenefitRule {
  id         String      @id @default(cuid())
  campaignId String      @unique
  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       BenefitType
  value      Int // centavos por unidad o porcentaje en centésimas (1000 = 10,00 %)
  notes      String?
  updatedAt  DateTime    @updatedAt
}

model BenefitSettlement {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  amount      Int
  settledAt   DateTime
  reference   String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
}

// ───────────────────────── Pedidos ─────────────────────────

model Buyer {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  email     String
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([clubId, email])
}

enum OrderStatus {
  PENDING_PAYMENT // creado, esperando seña o pago
  CONFIRMED // seña o pago aprobado
  CANCELLED
  EXPIRED // venció la reserva sin pago
}

enum DeliveryMethod {
  PICKUP
  SHIPPING
}

enum DeliveryStatus {
  NOT_READY
  READY
  PARTIAL
  DELIVERED
}

model Order {
  id               String         @id @default(cuid())
  code             String         @unique // visible, aleatorio, no da acceso
  accessTokenHash  String         @unique // hash del enlace privado (búsqueda)
  accessTokenEnc   String // token cifrado, para reenviar el enlace por correo
  pickupCode       String         @unique // identificador para QR de retiro
  idempotencyKey   String
  clubId           String
  club             Club           @relation(fields: [clubId], references: [id])
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id])
  buyerId          String
  buyer            Buyer          @relation(fields: [buyerId], references: [id])
  buyerName        String
  buyerEmail       String
  buyerPhone       String
  memberNumber     String? // declarado por el comprador, no verificado
  deliveryMethod   DeliveryMethod @default(PICKUP)
  shippingAddress  String?
  notes            String?
  pricingModel     PricingModel   @default(LEGACY_DEPOSIT)
  // Totales (centavos), calculados en el servidor
  itemsTotal       Int
  persTotal        Int
  shippingTotal    Int
  discountTotal    Int            @default(0)
  total            Int
  depositRequired  Int // importe necesario para confirmar (en TEXTIL_ADVANCE = anticipo)
  advanceRequired  Int            @default(0) // anticipo textil (TEXTIL_ADVANCE)
  clubBalanceRequired Int         @default(0) // saldo a cobrar por el club
  advancePaid      Int            @default(0)
  clubPaid         Int            @default(0)
  // Estado
  status           OrderStatus    @default(PENDING_PAYMENT)
  confirmedAt      DateTime?
  reservedUntil    DateTime?
  overCapacity     Boolean        @default(false)
  // Pagos (desnormalizado, se recalcula desde Payment)
  paidAmount       Int            @default(0)
  inReviewAmount   Int            @default(0)
  refundedAmount   Int            @default(0)
  deliveryStatus   DeliveryStatus @default(NOT_READY)
  // Snapshot de condiciones aceptadas
  termsSnapshot    Json
  termsHash        String
  policyVersion    String?
  termsAcceptedAt  DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cancelledAt      DateTime?
  cancelReason     String?

  players    Player[]
  units      OrderUnit[]
  payments   Payment[]
  deliveries Delivery[]

  @@unique([campaignId, idempotencyKey])
  @@index([clubId])
  @@index([campaignId, status])
}

model Player {
  id       String      @id @default(cuid())
  orderId  String
  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name     String
  sport    String?
  category String?
  team     String?
  sort     Int         @default(0)
  units    OrderUnit[]
}

enum UnitStatus {
  ACTIVE
  CANCELLED
}

/// Una fila por producto vendido.
model OrderUnit {
  id               String       @id @default(cuid())
  ref              String       @unique // referencia corta para fabricación
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  productCode      String
  productName      String
  productDesc      String?
  unitPrice        Int // precio al socio
  listPrice        Int?
  textilPrice      Int?  // anticipo por la prenda (TEXTIL_ADVANCE)
  playerId         String?
  player           Player?      @relation(fields: [playerId], references: [id])
  persName         String?
  persNumber       String?
  persPrice        Int          @default(0) // total de adicionales de la unidad
  optionsTextil    Int          @default(0) // parte textil de los adicionales
  optionsClub      Int          @default(0) // parte club de los adicionales
  legend           String?      // leyenda de disciplina elegida, si aplica
  noSizeChange     Boolean      @default(false) // personalizada: sin cambio de talle voluntario
  benefitAmount    Int          @default(0) // fijado al confirmar
  status           UnitStatus   @default(ACTIVE)
  cancelledAt      DateTime?
  deliveryId       String?
  delivery         Delivery?    @relation(fields: [deliveryId], references: [id])
  sort             Int          @default(0)
  components       OrderUnitComponent[]
  options          OrderUnitOption[]
  lotUnits         ProductionLotUnit[]

  @@index([orderId])
}

/// Copia de cada opción elegida en la unidad.
model OrderUnitOption {
  id          String     @id @default(cuid())
  unitId      String
  unit        OrderUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  groupId     String?
  groupName   String
  role        OptionRole
  value       String
  priceTextil Int        @default(0)
  priceClub   Int        @default(0)
  sort        Int        @default(0)
}

model OrderUnitComponent {
  id           String    @id @default(cuid())
  unitId       String
  unit         OrderUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  garmentId    String
  garmentCode  String
  garmentName  String
  variant      String?
  label        String // "Camiseta"
  sizeLabel    String
  printTarget  Boolean   @default(false)
}

// ───────────────────────── Pagos ─────────────────────────

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
  REFUND
  ADVANCE // anticipo textil
  CLUB_BALANCE // saldo cobrado por el club
}

enum PaymentReceiver {
  TEXTIL
  CLUB
}

enum PaymentMethod {
  TRANSFER
  MERCADOPAGO
  CASH // registrado manualmente por usuario autorizado
  OTHER
}

enum PaymentStatus {
  CREATED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  order               Order         @relation(fields: [orderId], references: [id])
  kind                PaymentKind
  method              PaymentMethod
  amount              Int
  receiver            PaymentReceiver @default(TEXTIL)
  paidAt              DateTime? // fecha informada del cobro (registro manual)
  status              PaymentStatus @default(CREATED)
  statusDetail        String?
  // Transferencia
  operationRef        String?
  replacesPaymentId   String?
  // Mercado Pago
  providerPreferenceId String?
  providerPaymentId   String?       @unique
  initPoint           String?
  expiresAt           DateTime?
  simulated           Boolean       @default(false)
  // Conciliación con el proveedor (centavos)
  providerGross       Int? // importe de la operación
  providerTotalPaid   Int? // pagado por el comprador, con intereses de financiación
  providerNet         Int? // neto acreditado
  providerFees        Json? // detalle de cargos informado por el proveedor
  installments        Int?
  // Revisión
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdById         String? // usuario del panel, si lo registró un administrador
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  receipts            Receipt[]

  @@index([orderId])
  @@index([status])
}

model Receipt {
  id           String   @id @default(cuid())
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileKey      String
  mime         String
  size         Int
  originalName String?
  uploadedAt   DateTime @default(now())
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  accountId   String?
  eventKey    String   @unique
  dataId      String?
  signatureOk Boolean
  result      String?
  payload     Json?
  receivedAt  DateTime @default(now())
  count       Int      @default(1)
}

/// Pagos del simulador (solo pruebas). Hace las veces de "proveedor".
model SimulatedPayment {
  id               String   @id @default(cuid())
  paymentId        String
  status           String
  amount           Int
  createdAt        DateTime @default(now())
}

// ───────────────────────── Producción ─────────────────────────

enum LotStatus {
  PENDING_APPROVAL
  APPROVED
  IN_PRODUCTION
  QUALITY_CONTROL
  READY_TO_SHIP
  RECEIVED_BY_CLUB
}

enum LotKind {
  MAIN
  ADJUSTMENT
}

model ProductionLot {
  id          String              @id @default(cuid())
  campaignId  String
  campaign    Campaign            @relation(fields: [campaignId], references: [id])
  number      Int // 1, 2, 3 dentro de la campaña
  kind        LotKind             @default(MAIN)
  status      LotStatus           @default(PENDING_APPROVAL)
  snapshot    Json? // congelado al aprobar
  notes       String?
  createdById String
  createdAt   DateTime            @default(now())
  approvedAt  DateTime?
  approvedById String?
  updatedAt   DateTime            @updatedAt
  shipmentId  String?
  shipment    ClubShipment?       @relation(fields: [shipmentId], references: [id])
  units       ProductionLotUnit[]

  @@unique([campaignId, number])
}

model ProductionLotUnit {
  id     String        @id @default(cuid())
  lotId  String
  lot    ProductionLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  unitId String
  unit   OrderUnit     @relation(fields: [unitId], references: [id])
  delta  Int           @default(1) // +1 alta, −1 baja por ajuste

  @@unique([lotId, unitId])
  @@index([unitId])
}

// ───────────────────────── Entregas ─────────────────────────

model Delivery {
  id               String      @id @default(cuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id])
  deliveredAt      DateTime    @default(now())
  deliveredById    String
  receivedByName   String
  receivedByNote   String? // relación o documento informado
  balanceException String? // motivo si se entregó con saldo
  notes            String?
  units            OrderUnit[]
}

// ───────────────────────── Correo e historial ─────────────────────────

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  NOT_SENT_NO_PROVIDER
}

model EmailOutbox {
  id        String      @id @default(cuid())
  orderId   String?
  to        String
  template  String
  subject   String
  body      String
  status    EmailStatus @default(QUEUED)
  error     String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String? // rol o "BUYER" / "SYSTEM" / "PROVIDER"
  clubId    String?
  entity    String
  entityId  String
  action    String
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([clubId, createdAt])
}


// ───────────────────────── Acuerdo, muestrario y compras del club ─────────────────────────

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

/// Acuerdo comercial privado con el club. Nunca se publica en la tienda.
model ClubAgreement {
  id                   String          @id @default(cuid())
  clubId               String
  club                 Club            @relation(fields: [clubId], references: [id])
  status               AgreementStatus @default(DRAFT)
  startsAt             DateTime
  endsAt               DateTime
  exclusive            Boolean         @default(true)
  brandLine            String? // ej. "Club X by Marca"
  samplesCommitted     String?
  catalogAgreed        String?
  activationConditions String?
  initialPurchases     String?
  pricingRules         String?
  notes                String?
  contractFileKey      String?
  contractFileName     String?
  alertDaysBefore      Int             @default(60)
  lastAlertAt          DateTime?
  createdById          String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([clubId])
}

enum SampleKind {
  TOP // prendas superiores
  BOTTOM // prendas inferiores
  OTHER
}

enum SampleAvailability {
  PENDING_DELIVERY
  AVAILABLE
  NOT_AVAILABLE
}

/// Curva de talles del muestrario para que los socios se prueben.
model SizeSampleSet {
  id                 String             @id @default(cuid())
  clubId             String
  club               Club               @relation(fields: [clubId], references: [id])
  kind               SampleKind
  name               String
  referenceGarmentId String?
  referenceGarment   Garment?           @relation(fields: [referenceGarmentId], references: [id])
  deliveredAt        DateTime?
  availability       SampleAvailability @default(PENDING_DELIVERY)
  location           String? // lugar de prueba
  notes              String?
  purchaseId         String? // compra que lo originó, si se registró
  purchase           ClubPurchase?      @relation(fields: [purchaseId], references: [id])
  createdAt          DateTime           @default(now())
  items              SizeSampleItem[]
  productLinks       ProductSampleLink[]
}

model SizeSampleItem {
  id        String        @id @default(cuid())
  setId     String
  set       SizeSampleSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  sizeLabel String
  quantity  Int           @default(1)
  sort      Int           @default(0)
}

/// Equivalencia de calce producto–curva, aprobada por la textil.
model ProductSampleLink {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  setId        String
  set          SizeSampleSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  approved     Boolean       @default(false)
  approvedAt   DateTime?
  approvedById String?
  notes        String?

  @@unique([productId, setId])
}

enum PurchasePurpose {
  SAMPLE // muestrario para probar talles
  INITIAL // compra inicial para garantizar producción
  BACKUP // unidades de respaldo para cambios
}

enum SizeDistributionStatus {
  PENDING
  DEFINED
}

/// Compra del club a la textil. Una compra puede cumplir más de una función si se confirma.
model ClubPurchase {
  id                 String                 @id @default(cuid())
  clubId             String
  club               Club                   @relation(fields: [clubId], references: [id])
  campaignId         String?
  campaign           Campaign?              @relation(fields: [campaignId], references: [id])
  productId          String?
  product            Product?               @relation(fields: [productId], references: [id])
  purposes           PurchasePurpose[]
  committedQty       Int
  paidQty            Int                    @default(0)
  paidAmount         Int? // centavos, si corresponde
  sizeStatus         SizeDistributionStatus @default(PENDING)
  approvedAt         DateTime?
  approvedById       String?
  notes              String?
  createdById        String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  items              ClubPurchaseItem[]
  sampleSets         SizeSampleSet[]
  campaignProducts   CampaignProduct[]
}

model ClubPurchaseItem {
  id         String       @id @default(cuid())
  purchaseId String
  purchase   ClubPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sizeLabel  String
  quantity   Int
}

// ───────────────────────── Entrega consolidada al club ─────────────────────────

enum ShipmentStatus {
  PREPARING
  DISPATCHED
  RECEIVED
}

enum CostBearer {
  PENDING // a definir
  TEXTIL
  CLUB
}

/// Despacho de la producción de la textil al club.
model ClubShipment {
  id            String         @id @default(cuid())
  number        Int
  clubId        String
  club          Club           @relation(fields: [clubId], references: [id])
  campaignId    String
  campaign      Campaign       @relation(fields: [campaignId], references: [id])
  status        ShipmentStatus @default(PREPARING)
  address       String
  receiverName  String // responsable de recepción
  receiverPhone String?
  carrier       String? // transporte o modalidad (ej. Via Cargo)
  trackingRef   String?
  cost          Int? // centavos, si se conoce
  costBearer    CostBearer     @default(PENDING)
  dispatchedAt  DateTime?
  receivedAt    DateTime?
  receivedBy    String?
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())
  lots          ProductionLot[]

  @@unique([campaignId, number])
}
