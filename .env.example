# ───────── Obligatorias ─────────
# PostgreSQL 16
DATABASE_URL=postgresql://camada:cambiar@localhost:5432/camada
# URL pública, sin barra final. Se usa en enlaces privados, QR, back_urls y webhooks de Mercado Pago.
APP_URL=https://preventa.ejemplo.com.ar
# 32 bytes en base64. Cifra las credenciales de Mercado Pago y los enlaces privados.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No cambiarla después de cargar credenciales o pedidos.
APP_ENCRYPTION_KEY=
# Secreto de la tarea programada /api/cron/mantenimiento (mínimo 16 caracteres)
CRON_SECRET=
# Carpeta persistente para imágenes y comprobantes (volumen en producción)
UPLOAD_DIR=/data/uploads

# ───────── Opcionales ─────────
# Marca textil para la línea "Club by Marca"
TEXTIL_BRAND=Walkersport
PLATFORM_NAME=Walkersport
# Simulador de pagos: SOLO pruebas. Con "enabled", las cuentas sin credenciales de Mercado Pago usan un checkout simulado.
PAYMENT_SIMULATOR=disabled
# Credenciales de Mercado Pago de la textil (las de cada club se cargan cifradas desde el panel, en Cuentas de cobro)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Correo saliente. Sin esto, los avisos quedan registrados como "no enviados".
# Ej.: smtps://usuario:clave@smtp.proveedor.com:465
SMTP_URL=
MAIL_FROM=Tienda del club <no-responder@ejemplo.com.ar>
# Límite de pedidos por minuto e IP
ORDER_RATE_LIMIT=20
# Contenedor: cargar datos de demostración al iniciar si la base está vacía
SEED_DEMO=0
# Solo para docker-compose
POSTGRES_PASSWORD=
